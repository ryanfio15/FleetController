# Copy to .env before the first `./fc.sh up`.  .env is gitignored.
# Stage 0 values only — see docs/TECHNICAL_PLAN.md §7.3 for the Stage 1+ story.

# --- TimescaleDB ---
POSTGRES_USER=fleet
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=fleet

# --- Fleet ---
# The "one number" from the outline. Raise it with: ./fc.sh scale 50
SIM_COUNT=3

# --- Sim behaviour ---
SIM_SAMPLE_HZ=1
# Hard floor on end-to-end latency; keep well under the 5s SLO.
SIM_BATCH_SECONDS=2
# none | overheat | weak_battery | dtc | flatline  (see ./fc.sh fault)
SIM_FAULT=none

# --- Ingest ---
# Stage 0 has no client certs yet, so identity comes from the request body.
# P2 sets this to false and takes the vehicle_id from the cert CN instead.
INGEST_ALLOW_INSECURE_IDENTITY=true
INGEST_MAX_READINGS_PER_BATCH=500

# --- Fleet API ---
# True until Keycloak exists (P3): the caller is whoever X-Fleet-User and
# X-Fleet-Role say they are. The web UI's "viewing as" switcher is this
# setting made visible. Set false and every request is 401.
FLEET_ALLOW_DEV_IDENTITY=true

# --- Host ports ---
# Change if something already owns these on your machine.
GRAFANA_PORT=3000
# The web UI is the single origin: it serves the page and proxies /api and
# /grafana, the way ingress-nginx does in the cluster. Open this one.
WEB_UI_PORT=8088
# fleet-api direct, for curl. The browser does not use it.
FLEET_API_PORT=8081

# --- Logging ---
LOG_LEVEL=INFO
