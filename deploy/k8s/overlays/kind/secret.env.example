# Copy to secret.env before the first ./fc.sh k8s-up. secret.env is gitignored.
#
# Same shape as the repository's .env, and for the same reason (§7.3): the
# values belong in the environment, not in a committed file. These three keys
# are the whole `fleet-db` Secret — every connection string in the base is
# composed from them inside the pod spec, so the password is stored once.
#
# For FABRIC these are sealed with kubeseal instead; see
# deploy/k8s/overlays/fabric/README.md.
POSTGRES_USER=fleet
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=fleet
