# secrets & generated material
.env
tools/certs/out/
*.pem
*.key
*.crt
*.csr
*.srl

# kustomize secretGenerator inputs. Only the *.example files are committed —
# sealed secrets are safe to commit and are named *-sealed.yaml.
deploy/k8s/overlays/*/secret.env
!deploy/k8s/overlays/*/secret.env.example

# fetched cluster kubeconfigs
deploy/fabric/kubeconfig*

# fablib virtualenv (it pins a large dependency tree)
.venv-fabric/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# local state
data/
*.log

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# midpoint presentation — local only, never committed
midpointpres/

# A filled-in ~/.fabric_rc: names a project GUID, a bastion username and the
# paths of two private keys. fabric_rc.example documents every variable, so
# there is nothing here worth committing. Copy it to ~/.fabric_rc instead.
deploy/fabric/fabric_rc.txt
